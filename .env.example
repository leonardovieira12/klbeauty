# Copie para .env APENAS para execução local. Nunca envie .env ao GitHub.
DATABASE_URL=postgresql://usuario:senha@host:5432/klbeauty
# Para URL interna do Render: disable. Externa: verify (valida certificado).
DATABASE_SSL=disable
ADMIN_EMAIL=seu-email@exemplo.com
# Escolha uma senha exclusiva com pelo menos 12 caracteres.
ADMIN_PASSWORD=
NODE_ENV=development
PORT=10000
# Em produção: URL https real do Web Service, sem barra no fim.
APP_URL=http://localhost:10000
